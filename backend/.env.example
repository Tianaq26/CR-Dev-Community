# Environment variables read by the API. In development none are required.
# In production (Railway / Render / Fly…) set them in the service's Variables panel.

# REQUIRED in production. At least 32 characters. Generate with:  openssl rand -base64 48
JWT_SECRET=

# REQUIRED in production. postgresql:// URL from Neon, Railway, Supabase, Render…
# Unset in development: the API uses a local SQLite file (crdev.db).
DATABASE_URL=

# Comma-separated origins allowed to call the API. "*" works as a subdomain wildcard.
# Example: https://crdev.vercel.app,https://*.vercel.app,https://crdevcommunity.com
CORS_ORIGINS=http://localhost:5173

# true = on an empty database create a demo community (demo@crdev.community / demo1234).
# Defaults to true in development and false in production.
SEED_DEMO=false

# Optional. Login/register attempts allowed per IP per minute (default 10).
# RateLimit__AuthPerMinute=10
