# Copy to .env.local for local overrides. In Vercel set these under Project → Settings → Environment Variables.

# Leave empty in development: Vite proxies /api to http://localhost:5080.
# In production put the public URL of the API, without a trailing slash.
VITE_API_URL=

# Shows the "cuenta de demostración" button on the login page (always on in dev).
# Only enable it in production while the API runs with SEED_DEMO=true.
VITE_DEMO_LOGIN=false
